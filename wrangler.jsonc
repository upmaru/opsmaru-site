{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opsmaru-site",
  "compatibility_date": "2026-11-13",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "opsmaru.dev", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
